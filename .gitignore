# This repo tracks only the hand-built pieces for the "board" layout:
# layouts/board.json, themes/board-readable-dark.json, and every mods/board*
# folder. Everything else here is either Herdr's own shipped layout/mods
# (rewritten on every start) or machine-written bookkeeping -- see AGENTS.md's
# file table -- so it's ignored wholesale rather than listed file by file.
*

!.gitignore
!layouts/
!layouts/board.json
!themes/
!themes/board-readable-dark.json
!mods/
!mods/board/
!mods/board/**
!mods/board-changes/
!mods/board-changes/**
!mods/board-files/
!mods/board-files/**
!mods/board-ide-menu/
!mods/board-ide-menu/**
!mods/board-menu/
!mods/board-menu/**
!mods/board-picker/
!mods/board-picker/**
!mods/board-preview/
!mods/board-preview/**
!mods/board-session/
!mods/board-session/**
!mods/board-timeline/
!mods/board-timeline/**
!mods/board-usage/
!mods/board-usage/**
!mods/board-worktree/
!mods/board-worktree/**
!mods/board-todo/
!mods/board-todo/**
!mods/board-find-in-path/
!mods/board-find-in-path/**
!mods/board-goto-file/
!mods/board-goto-file/**
!mods/board-common/
!mods/board-common/**

# board-common → 각 모드 _common/ 복사 스크립트
!scripts/
!scripts/**

# 표준 라이브러리 테스트(node --test, python3 -m unittest)
!tests/
!tests/**

# Written by Herdr into each mod folder for editor tooling; not hand-authored.
mods/board*/jsconfig.json
mods/board*/gpui-kit.d.ts

!README.md

# Python 바이트코드(테스트·실행 시 생성)
__pycache__/
*.pyc
